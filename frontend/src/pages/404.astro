---
import { ArrowLeft } from "lucide-react";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>404 - Page Not Found</title>
  </head>
  <body
    class="min-h-screen bg-[#0f0f10] flex flex-col items-center justify-center text-white px-6"
  >
    <div class="max-w-md text-center space-y-6">
      <h1 class="text-7xl font-extrabold text-indigo-500">404</h1>
      <h2 class="text-2xl font-semibold">Oops! Page not found</h2>
      <p class="text-gray-400">
        The page you are looking for might have been removed, had its name
        changed, or is temporarily unavailable.
      </p>

      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-2xl bg-indigo-500 px-5 py-2.5 font-medium text-white hover:bg-indigo-400 transition-all shadow-md"
      >
        <ArrowLeft size={18} /> Go back home
      </a>
    </div>
  </body>
</html>
