---
import Layout from "../layouts/BaseLayout.astro";

// Log to server console when this page renders
console.error("404 Error: User attempted to access non-existent route.");
---

<Layout>
  <div
    class="bg-[#090A0E] min-h-[70vh] flex flex-col items-center justify-center text-center px-4"
  >
    <h1 class="text-7xl md:text-9xl font-bold mb-6 text-red-400">404</h1>
    <h2 class="text-2xl md:text-4xl font-bold mb-4 text-white">
      Page Not Found
    </h2>
    <p class="text-lg text-gray-400 mb-10 max-w-lg">
      The page you're looking for doesn't exist or has been moved to another
      address.
    </p>
    <a
      href="/"
      class="bg-red hover:text-red-400/80 text-red-400 font-medium py-3 px-8 rounded-xl transition-colors"
    >
      Return to Home
    </a>
  </div>
</Layout>
