---
import type { SearchPost } from "@/hooks/usePost";
import { cn } from "@/lib/utils";

interface SearchPostCardProps {
  post: SearchPost;
  classNames?: string;
  variant: "compact" | "default";
}

const { post, classNames, variant } = Astro.props as SearchPostCardProps;

const isCompact = variant === "compact";

const getAvatarFallback = (name: string) => {
  const initial = name.split(" ")[0]?.charAt(0)?.toUpperCase() || "U";
  return `data:image/svg+xml;base64,${btoa(`
      <svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" fill="#151619"/>
        <text x="16" y="20" text-anchor="middle" fill="#ffffff" font-family="Arial" font-size="14" font-weight="bold">${initial}</text>
      </svg>
    `)}`;
};
---

<div
  class={cn(
    "group block relative overflow-hidden rounded-xl card-hover bg-[#151619] hover:bg-[#1A1B22] h-full transition-all duration-300",
    classNames,
  )}
>
  <div class="aspect-video w-full overflow-hidden relative">
    <img
      src={post.cover_image}
      alt={post.post_title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute top-3 left-3">
      <div
        class="px-3 py-1.5 bg-black/60 backdrop-blur-sm text-xs font-medium uppercase text-white rounded-lg hover:bg-black/70 transition-colors"
      >
        {post.category?.name || "Uncategorized"}
      </div>
    </div>
  </div>

  <div class="p-5">
    <h2
      class={cn(
        "font-bold line-clamp-2 mb-3 text-white group-hover:text-tech-red transition-colors",
        isCompact ? "text-base" : "text-lg md:text-xl",
      )}
    >
      {post.post_title}
    </h2>

    {
      !isCompact && (
        <p class="text-gray-400 text-sm line-clamp-2 mb-4">
          {post.short_content}
        </p>
      )
    }

    <div
      class="flex items-center justify-between mt-4 pt-4 border-t border-[#222]"
    >
      <div class="flex items-center">
        <img
          src={post.author.avatar || getAvatarFallback(post.author.full_name)}
          alt={post.author.full_name}
          class="h-7 w-7 rounded-full mr-2"
        />
        <span class="text-xs font-medium text-white"
          >{post.author.full_name}</span
        >
      </div>
    </div>
  </div>
</div>
