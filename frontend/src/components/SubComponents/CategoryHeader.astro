---
import { Tag, Hash } from "@lucide/astro";

interface CategoryHeaderProps {
  name: string;
  description?: string;
  postCount?: number;
}

const { name, description, postCount } =
  Astro.props as CategoryHeaderProps;
---

<div
  class="bg-[#151619]/80 border border-[#2A2C36] py-8 px-6 rounded-xl mb-8 backdrop-blur-sm shadow-lg"
>
  <div class="flex items-center gap-3 mb-3">
    <Hash class="text-tech-red" size="18" stroke-width={2.5} />
    <span class="text-sm text-tech-red font-medium uppercase tracking-wider">
      Category
    </span>
  </div>
  <h1 class="text-3xl md:text-4xl font-bold mb-3 text-white">
    {name}
  </h1>
  <p class="text-gray-400 text-lg mb-4">{description}</p>
  <div class="flex items-center mt-2">
    <div
      class="flex items-center bg-tech-red/10 text-tech-red text-sm py-1.5 px-4 rounded-full"
    >
      <Tag size={14} class="mr-1.5" stroke-width={2.5} />
      <span>{postCount} articles</span>
    </div>
  </div>
</div>
